<!--
    Mister-Psikyo - MiSTer FPGA core for the original Psikyo shooter arcade hardware.
    No ROM files included/distributed - dump your own. See ../Readme.md.

    DIP status-bit positions (bit 16+) are a provisional placeholder, not yet verified
    against real core RTL status[] wiring.
-->
<misterromdescription>
	<about author="Mister-Psikyo project" webpage="" source="MAME psikyo.cpp"/>
	<name>Samurai Aces (World)</name>
	<setname>samuraia</setname>
	<year>1993</year>
	<manufacturer>Psikyo (Banpresto license)</manufacturer>
	<category>Shoot 'Em Up</category>
	<rbf>Arcade-Psikyo</rbf>
	<rotation>vertical</rotation>
	<players>2</players>
	<joystick>8-way</joystick>
	<region>World</region>

	<rom index="0" zip="samuraia.zip" md5="none">
		<!-- maincpu: base 0x000000, reserved 0x200000. Two 16-bit ROMs reconstructing
		     MAME's ROM_LOAD32_WORD_SWAP pairing: u127 supplies the high word of each
		     long, u126 the low word, each word byte-swapped. The ascending map digit
		     form ("0012"/"1200") is what applies that swap; the descending form
		     ("0021"/"2100") leaves file order alone. Verified against MAME's
		     disassembly of the entry point, 18/18 words. Content 0x80000, padded.
		     Do not "correct" these by reasoning about byte order - see
		     docs/LESSONS_LEARNED.md. -->
		<interleave output="32">
			<part name="4-u127.bin" crc="8c9911ca" map="0012"/>
			<part name="5-u126.bin" crc="d20c3ef0" map="1200"/>
		</interleave>
		<part repeat="0x180000">FF</part>

		<!-- audiocpu: base 0x200000, reserved 0x040000 - Z80 sound program ROM.
		     Actual content 0x20000; padded to the full reservation. -->
		<part name="3-u58.bin" crc="310f5c76"/>
		<part repeat="0x20000">FF</part>

		<!-- sprites: base 0x240000, reserved 0x800000. ROM_LOAD16_WORD_SWAP in MAME,
		     so map="12" to apply the byte swap; rtl/video/tile_row_decode.sv expects
		     MAME's gfx_16x16x4_packed_msb layout. Content 0x200000, padded. -->
		<interleave output="16">
			<part name="u14.bin" crc="00a546cb" map="12"/>
		</interleave>
		<part repeat="0x600000">FF</part>

		<!-- tiles: base 0xA40000, reserved 0x200000. Two ROMs CONCATENATED (u34 at
		     region 0x000000, u35 at 0x100000), not interleaved with each other, so one
		     single-part interleave block each. Both ROM_LOAD16_WORD_SWAP. Exact fit. -->
		<interleave output="16">
			<part name="u34.bin" crc="e6a75bd8" map="12"/>
		</interleave>
		<interleave output="16">
			<part name="u35.bin" crc="c4ca0164" map="12"/>
		</interleave>

		<!-- ymsnd:adpcma: base 0xC40000, reserved 0x100000 - YM2610 ADPCM-A sample
		     ROM. Exact fit, no padding needed. -->
		<part name="u68.bin" crc="9a7f6c34"/>

		<!-- ymsnd:adpcmb: base 0xD40000, reserved 0x080000 - samuraia/sngkace have
		     NO ADPCM-B region at all (confirmed from ROM_START - only the gunbird
		     family does), so this entire reservation is padding. -->
		<part repeat="0x80000">FF</part>

		<!-- spritelut: base 0xDC0000, reserved 0x040000 - sprite code lookup table
		     ROM. Exact fit, no padding needed (also the last region - nothing
		     follows). -->
		<part name="u11.bin" crc="11a04d91"/>
	</rom>
	<!-- Board variant for the core, read as ioctl_index==1 (see Psikyo.sv).
	     00 = sngkace/samuraia layout, 01 = gunbird/btlkroad (KA302C):
	     coin/service folded into the P1_P2 low byte instead of a separate
	     COIN port, and live tile banking from layer-control bit 10. -->
	<rom index="1"><part>00</part></rom>


	<!-- Player controls / coin / start are handled through the standard MiSTer
	     joystick/coin input framework, not DIP switches - see psikyo.cpp
	     INPUT_PORTS_START(samuraia)'s "P1_P2"/"COIN" ports. 3 buttons/player. -->
	<buttons names="Button 1,Button 2,Button 3,-,-,-,Start,Coin,Pause" default="Y,B,A,Start,Select,R" count="3"/>

	<switches default="FD,FF,FF">
		<!-- <switches> default bytes map to dip_cur bits: byte0 -> bits 7:0,
		     byte1 -> status[31:24], byte2 -> status[39:32]. Psikyo.sv feeds those into
		     the upper half of the 32-bit DSW long at $C00004, with byte2 as the region
		     jumper in its low byte. Defaults match MAME's PORT_DIPNAME defaults:
		     Demo Sounds On, Difficulty Normal, 3 Lives, Bonus 400K, Service Mode Off,
		     1C 1C, region World. -->

		<dip name="Flip Screen" bits="0" ids="On,Off"/>
		<dip name="Demo Sounds" bits="1" ids="On,Off"/>
		<dip name="Difficulty" bits="2,3" ids="Hardest,Hard,Easy,Normal"/>
		<dip name="Lives" bits="4,5" ids="4,2,1,3"/>
		<dip name="Bonus Life" bits="6" ids="600K,400K"/>
		<dip name="Service Mode" bits="7" ids="On,Off"/>
		<dip name="Coin Slot" bits="8" ids="Individual (Free Play),Shared"/>
		<dip name="Coin A" bits="9,10,11" ids="1C 6C (Free Play),1C 5C,1C 4C,1C 3C,1C 2C,3C 1C,2C 1C,1C 1C"/>
		<dip name="Coin B" bits="12,13,14" ids="1C 6C (Free Play),1C 5C,1C 4C,1C 3C,1C 2C,3C 1C,2C 1C,1C 1C"/>
		<dip name="2 Coins Start, 1 Coin Continue" bits="15" ids="On (Free Play),Off"/>

		<!-- Region: a real PORT_CONFNAME on this hardware (same physical ROM set
		     services all of these regions via this switch - NOT the same thing as
		     the separate Sengoku Ace (Japan) romset/mra, which has genuinely
		     different program ROM content). Sparse one-bit-cleared-per-region
		     encoding, not a binary counter - uses "values" for the raw byte per
		     option rather than relying on positional order. -->
		<dip name="Region" bits="16,17,18,19,20,21,22,23" ids="Taiwan,Hong Kong,Korea,USA and Canada,World" values="0x7f,0xbf,0xdf,0xef,0xff"/>
	</switches>

	<mratimestamp>20260822220000</mratimestamp>
</misterromdescription>
