<!--
    Mister-Psikyo - MiSTer FPGA core for the original Psikyo shooter arcade hardware.
    No ROM files included/distributed - dump your own. See ../Readme.md.

    DIP status-bit positions (bit 16+) are a provisional placeholder, not yet verified
    against real core RTL status[] wiring.
-->
<misterromdescription>
	<about author="Mister-Psikyo project" webpage="" source="MAME psikyo.cpp"/>
	<name>Samurai Aces (World)</name>
	<setname>samuraia</setname>
	<year>1993</year>
	<manufacturer>Psikyo (Banpresto license)</manufacturer>
	<category>Shoot 'Em Up</category>
	<rbf>Arcade-Psikyo</rbf>
	<rotation>vertical</rotation>
	<players>2</players>
	<joystick>8-way</joystick>
	<region>World</region>

	<rom index="0" zip="samuraia.zip" md5="none">
		<!-- maincpu: base 0x000000, reserved 0x200000 - 68EC020 program ROM, two
		     16-bit-wide ROMs word-swap-interleaved to reconstruct MAME's
		     ROM_LOAD32_WORD_SWAP pairing (offset 0 = high word, offset 2 = low word).
		     Actual content 0x80000; padded to the full reservation.

		     2026-08-23: briefly "corrected" this to swap 4-u127.bin/5-u126.bin based
		     on a wrong mental model of the `map` attribute (assumed it picked which
		     file supplies the high vs low word). Confirmed via
		     github.com/MiSTer-devel/Main_MiSTer/wiki/Arcade-Roms-and-MRA-files that
		     `map` actually reorders bytes WITHIN one part's own stream (e.g. map="10"
		     swaps a byte pair), independent of file identity/order. Recomputing with
		     the correct semantics against this file's ORIGINAL (unedited) pairing --
		     u127 unswapped (map=01), u126 byte-pair-swapped (map=10), interleaved in
		     listing order -- decodes the reset vector as SP=0xffff8000 (top of a
		     high-address-mirrored work RAM region, a standard 68k idiom) and
		     PC=0x00000400 (a clean, plausible code-entry address): this original
		     pairing is correct. Reverted.  <<< THAT CONCLUSION WAS ALSO WRONG,
		     superseded by the note immediately below.
		     2026-08-23 (second correction, this one verified): the block below
		     used to be <interleave output="16"> with u127 map="01" and u126
		     map="10". Those digits do NOT mean "swap the byte pair within this
		     part" -- that reading was wrong. Each digit is an OUTPUT BYTE LANE
		     (leftmost = highest byte) and its VALUE selects which input byte of
		     that part feeds the lane, with 0 meaning "this part does not supply
		     this lane". Confirmed against working MiSTer MRAs using both a
		     4-part output="64" form (map="00000021"/"00002100"/... ) and a
		     4-part output="32" form (map="1000"/"0100"/"0010"/"0001").
		     So map="01"+map="10" at output="16" produced a BYTE-level
		     interleave, word = {u126[i] high, u127[i] low}, which decodes the
		     reset vector as SP=0x00ff80ff -- a corrupt, odd stack pointer --
		     even though PC=0x00000400 comes out correct. On real hardware that
		     boots and executes correctly from 0x400 and then dies at the first
		     stack operation.
		     MAME uses ROM_LOAD32_WORD_SWAP: u127 supplies the high 16-bit word
		     of each long, u126 the low word, each word byte-swapped. As
		     output="32" byte lanes that is u127 -> bytes 3,2 in order ("12")
		     and u126 -> bytes 1,0 swapped ("21"). Decodes SP=0xffff8000
		     PC=0x00000400, matching sim/psikyo_top_tb/gen_real_rom.py, which is
		     the image the ModelSim real-ROM boot test runs from successfully. -->
		<interleave output="32">
			<part name="4-u127.bin" crc="8c9911ca" map="1200"/>
			<part name="5-u126.bin" crc="d20c3ef0" map="0021"/>
		</interleave>
		<part repeat="0x180000">FF</part>

		<!-- audiocpu: base 0x200000, reserved 0x040000 - Z80 sound program ROM.
		     Actual content 0x20000; padded to the full reservation. -->
		<part name="3-u58.bin" crc="310f5c76"/>
		<part repeat="0x20000">FF</part>

		<!-- sprites: base 0x240000, reserved 0x800000 - zoom sprite tile graphics.
		     Actual content 0x200000 (this family's sprites region is the smallest of
		     any Phase 1 game - gunbird's needs the full 0x700000); padded to the
		     full reservation. -->
		     MAME loads this with ROM_LOAD16_WORD_SWAP, i.e. every 16-bit word is
		     byte-swapped into the region, and rtl/video/tile_row_decode.sv was
		     verified against THAT layout (MAME's gfx_16x16x4_packed_msb). Loading
		     the file raw here left the whole sprites region byte-pair-swapped
		     relative to what the decoder expects -- at 4bpp each byte is 2 pixels,
		     so every group of 4 pixels in a tile row came out transposed, which on
		     real hardware looked like structured-but-scrambled sprites. map="21"
		     replicates the WORD_SWAP (digits are output byte lanes, value = which
		     input byte feeds that lane, so 21 = swapped pair; confirmed against
		     working MiSTer MRAs using the same idiom at output="64"). -->
		<interleave output="16">
			<part name="u14.bin" crc="00a546cb" map="21"/>
		</interleave>
		<part repeat="0x600000">FF</part>

		<!-- tiles: base 0xA40000, reserved 0x200000 - tilemap layer 0+1 graphics, 2
		     ROMs concatenated (not interleaved with each other). Exact fit, no
		     padding needed. -->
		     Both are ROM_LOAD16_WORD_SWAP in MAME -- same reasoning as the sprites
		     region above, so each gets its own map="21" interleave. They are
		     CONCATENATED, not interleaved with each other (u34 at region 0x000000,
		     u35 at 0x100000), hence two separate single-part blocks rather than one
		     two-part block. -->
		<interleave output="16">
			<part name="u34.bin" crc="e6a75bd8" map="21"/>
		</interleave>
		<interleave output="16">
			<part name="u35.bin" crc="c4ca0164" map="21"/>
		</interleave>

		<!-- ymsnd:adpcma: base 0xC40000, reserved 0x100000 - YM2610 ADPCM-A sample
		     ROM. Exact fit, no padding needed. -->
		<part name="u68.bin" crc="9a7f6c34"/>

		<!-- ymsnd:adpcmb: base 0xD40000, reserved 0x080000 - samuraia/sngkace have
		     NO ADPCM-B region at all (confirmed from ROM_START - only the gunbird
		     family does), so this entire reservation is padding. -->
		<part repeat="0x80000">FF</part>

		<!-- spritelut: base 0xDC0000, reserved 0x040000 - sprite code lookup table
		     ROM. Exact fit, no padding needed (also the last region - nothing
		     follows). -->
		<part name="u11.bin" crc="11a04d91"/>
	</rom>

	<!-- Player controls / coin / start are handled through the standard MiSTer
	     joystick/coin input framework, not DIP switches - see psikyo.cpp
	     INPUT_PORTS_START(samuraia)'s "P1_P2"/"COIN" ports. 3 buttons/player. -->
	<buttons names="Button 1,Button 2,Button 3,-,-,-,Start,Coin,Pause" default="Y,B,A,Start,Select,R" count="3"/>

	<switches default="FF,FF,FD,FF,FF">
		<!-- byte0 (status bits 0-7), byte1 (bits 8-15): reserved for standard OSD
		     options, not game DIPs - psikyo.cpp's own DSW word leaves these bits
		     unused ("these depends by the games", i.e. no function on this title). -->

		<dip name="Flip Screen" bits="16" ids="On,Off"/>
		<dip name="Demo Sounds" bits="17" ids="On,Off"/>
		<dip name="Difficulty" bits="18,19" ids="Hardest,Hard,Easy,Normal"/>
		<dip name="Lives" bits="20,21" ids="4,2,1,3"/>
		<dip name="Bonus Life" bits="22" ids="600K,400K"/>
		<dip name="Service Mode" bits="23" ids="On,Off"/>
		<dip name="Coin Slot" bits="24" ids="Individual (Free Play),Shared"/>
		<dip name="Coin A" bits="25,26,27" ids="1C 6C (Free Play),1C 5C,1C 4C,1C 3C,1C 2C,3C 1C,2C 1C,1C 1C"/>
		<dip name="Coin B" bits="28,29,30" ids="1C 6C (Free Play),1C 5C,1C 4C,1C 3C,1C 2C,3C 1C,2C 1C,1C 1C"/>
		<dip name="2 Coins Start, 1 Coin Continue" bits="31" ids="On (Free Play),Off"/>

		<!-- Region: a real PORT_CONFNAME on this hardware (same physical ROM set
		     services all of these regions via this switch - NOT the same thing as
		     the separate Sengoku Ace (Japan) romset/mra, which has genuinely
		     different program ROM content). Sparse one-bit-cleared-per-region
		     encoding, not a binary counter - uses "values" for the raw byte per
		     option rather than relying on positional order. -->
		<dip name="Region" bits="32,33,34,35,36,37,38,39" ids="Taiwan,Hong Kong,Korea,USA and Canada,World" values="0x7f,0xbf,0xdf,0xef,0xff"/>
	</switches>

	<mratimestamp>20260822220000</mratimestamp>
</misterromdescription>
