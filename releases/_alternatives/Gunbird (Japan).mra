<!--
    Mister-Psikyo - MiSTer FPGA core for the original Psikyo shooter arcade hardware.
    No ROM files included/distributed - dump your own. See ../../Readme.md.

    MAME clone of gunbird. No Region dip (IPT_UNKNOWN on this set). See
    "Gunbird (World).mra" for shared layout/DIP notes.
-->
<misterromdescription>
	<about author="Mister-Psikyo project" webpage="" source="MAME psikyo.cpp"/>
	<name>Gunbird (Japan)</name>
	<setname>gunbirdj</setname>
	<year>1994</year>
	<manufacturer>Psikyo</manufacturer>
	<category>Shoot 'Em Up</category>
	<rbf>Arcade-Psikyo</rbf>
	<rotation>vertical</rotation>
	<players>2</players>
	<joystick>8-way</joystick>
	<region>Japan</region>

	<rom index="0" zip="gunbirdj.zip|gunbird.zip" md5="none">
		<!-- maincpu: base 0x000000, reserved 0x200000 - this set's own revision
		     (different CRCs than gunbird's or gunbirdk's). Actual 0x80000. -->
		<interleave output="32">
			<part name="1.u46" crc="474abd69" map="0012"/>
			<part name="2.u39" crc="3e3e661f" map="1200"/>
		</interleave>
		<part repeat="0x180000">FF</part>

		<!-- audiocpu: base 0x200000, reserved 0x040000 - identical to gunbird's. -->
		<part name="3.u71" crc="2168e4ba"/>
		<part repeat="0x20000">FF</part>

		<!-- sprites: base 0x240000, reserved 0x800000 - identical to gunbird's. -->
		<interleave output="16">
			<part name="u14.bin" crc="7d7e8a00" map="12"/>
		</interleave>
		<interleave output="16">
			<part name="u24.bin" crc="5e3ffc9d" map="12"/>
		</interleave>
		<interleave output="16">
			<part name="u15.bin" crc="a827bfb5" map="12"/>
		</interleave>
		<interleave output="16">
			<part name="u25.bin" crc="ef652e0c" map="12"/>
		</interleave>
		<part repeat="0x100000">FF</part>

		<!-- tiles: base 0xA40000, reserved 0x200000 - identical to gunbird's. -->
		<part name="u33.bin" crc="54494e6b"/>

		<!-- ymsnd:adpcma: base 0xC40000, reserved 0x100000 - identical to gunbird's. -->
		<part name="u56.bin" crc="9e07104d"/>

		<!-- ymsnd:adpcmb: base 0xD40000, reserved 0x080000 - identical to gunbird's. -->
		<part name="u64.bin" crc="e187ed4f"/>

		<!-- spritelut: base 0xDC0000, reserved 0x040000 - identical to gunbird's. -->
		<part name="u3.bin" crc="0905aeb2"/>
	</rom>

	<buttons names="Button 1,Button 2,Button 3,-,-,-,Start,Coin,Pause" default="Y,B,A,Start,Select,R" count="3"/>

	<switches default="FF,FF,FD,FF">
		<!-- byte0/byte1: reserved (see Samurai Aces (World).mra). No Region byte  - 
		     gunbirdj's Region field is IPT_UNKNOWN, unlike the parent's. -->

		<dip name="Flip Screen" bits="0" ids="On,Off"/>
		<dip name="Demo Sounds" bits="1" ids="On,Off"/>
		<dip name="Difficulty" bits="2,3" ids="Hardest,Hard,Easy,Normal"/>
		<dip name="Lives" bits="4,5" ids="4,2,1,3"/>
		<dip name="Bonus Life" bits="6" ids="600K,400K"/>
		<dip name="Service Mode" bits="7" ids="On,Off"/>
		<dip name="Coin Slot" bits="8" ids="Individual (Free Play),Shared"/>
		<dip name="Coin A" bits="9,10,11" ids="1C 6C (Free Play),1C 5C,1C 4C,1C 3C,1C 2C,3C 1C,2C 1C,1C 1C"/>
		<dip name="Coin B" bits="12,13,14" ids="1C 6C (Free Play),1C 5C,1C 4C,1C 3C,1C 2C,3C 1C,2C 1C,1C 1C"/>
		<dip name="2 Coins Start, 1 Coin Continue" bits="15" ids="On (Free Play),Off"/>
	</switches>

	<mratimestamp>20260825000000</mratimestamp>
</misterromdescription>
